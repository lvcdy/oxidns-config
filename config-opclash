# OxiDNS v1.5.1
# 简化架构：user -> dnsmasq -> OxiDNS(:5335) -> OpenClash(:7874)
# 作用：广告拦截 + 恶意/钓鱼/黑客域名拦截，其余域名转发给 OpenClash

log:
  level: warn
  file: ./oxidns.log
  rotation:
    type: daily
    max_files: 3

api:
  http:
    listen: 0.0.0.0:9199
    webui:
      root: /usr/share/oxidns/webui

plugins:
  # 定时更新规则
  - tag: cron_update
    type: cron
    args:
      timezone: Asia/Shanghai
      jobs:
        - name: update_rules
          interval: 1d
          executors:
            - $download_rules
            - $reload_rules

  - tag: download_rules
    type: download
    args:
      downloads:
        # 广告拦截规则
        - url: https://anti-ad.net/adguard.txt
          dir: /etc/oxidns/rules
          filename: antiad.txt
        - url: https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt
          dir: /etc/oxidns/rules
          filename: adguard.txt
        - url: https://adaway.org/hosts.txt
          dir: /etc/oxidns/rules
          filename: adaway.txt
        - url: https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblockdns.txt
          dir: /etc/oxidns/rules
          filename: adblock.txt
        # 恶意域名拦截规则（防黑客/防钓鱼/防恶意软件）
        - url: https://big.oisd.nl
          dir: /etc/oxidns/rules
          filename: oisd_big.txt
        - url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.mini.txt
          dir: /etc/oxidns/rules
          filename: hagezi_pro_mini.txt
        # geosite（含 category-ads-all 广告分类）
        - url: https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat
          dir: /etc/oxidns/rules
          filename: geosite.dat
      timeout: 120s
      startup_if_missing: true

  - tag: reload_rules
    type: reload_provider
    args:
      - $ad_rules
      - $security_rules
      - $category_ads_all

  # 规则提供者
  - tag: ad_rules
    type: adguard_rule
    args:
      files:
        - /etc/oxidns/rules/antiad.txt
        - /etc/oxidns/rules/adguard.txt
        - /etc/oxidns/rules/adaway.txt
        - /etc/oxidns/rules/adblock.txt

  # 恶意域名拦截规则（防黑客/防钓鱼/防恶意软件）
  - tag: security_rules
    type: adguard_rule
    args:
      files:
        - /etc/oxidns/rules/oisd_big.txt
        - /etc/oxidns/rules/hagezi_pro_mini.txt

  - tag: category_ads_all
    type: geosite
    args:
      file: /etc/oxidns/rules/geosite.dat
      selectors:
        - category-ads-all

  # 域名/IP集合
  - tag: hosts
    type: hosts
    args:
      short_circuit: true

  # 广告拦截
  - tag: ad_blackhole
    type: black_hole
    args:
      mode: null
      short_circuit: true

  # 转发至 OpenClash
  - tag: forward_openclash
    type: forward
    args:
      concurrent: 1
      response_selection: balanced
      upstreams:
        - tag: openclash_dns
          addr: 127.0.0.1:7874
          timeout: 5s
      short_circuit: false

  # 主序列
  - tag: main_sequence
    type: sequence
    args:
      # 1. 本地 hosts 优先
      - exec: $hosts
      - matches: has_resp
        exec: accept
      # 2. 广告拦截
      - matches: qname $ad_rules
        exec: $ad_blackhole
      - matches: qname $category_ads_all
        exec: $ad_blackhole
      # 3. 恶意/钓鱼域名拦截（防黑客）
      - matches: qname $security_rules
        exec: $ad_blackhole
      # 4. 其余请求全部转发给 OpenClash
      - exec: $forward_openclash
      - matches: has_resp
        exec: accept
      - exec: reject 3

  # 监听服务器
  - tag: udp_server
    type: udp_server
    args:
      entry: main_sequence
      listen: :5335

  - tag: tcp_server
    type: tcp_server
    args:
      entry: main_sequence
      listen: :5335
